w"}}, "Name": {"id": "title", "type": "title", "title": [{"type": "text", "text": {"content": "ACS Comparison Table", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "ACS Comparison Table", "href": null}]}}, "url": "https://app.notion.com/p/ACS-Comparison-Table-31b5964e68a48174976bca8cb2e4b9fe", "public_url": "https://malleuscm.notion.site/ACS-Comparison-Table-31b5964e68a48174976bca8cb2e4b9fe", "archived": false, "_block_html": "<table><tbody><tr><td></td><td>Stable angina</td><td>Unstable angina</td><td>NSTEMI</td><td>STEMI</td></tr>\n<tr><td><strong>Duration</strong></td><td>< 10 minutes</td><td>> 10\u201320 minutes</td><td>> 10\u201320 minutes</td><td>> 10\u201320 minutes</td></tr>\n<tr><td><strong>ECG</strong></td><td>Negative</td><td>\u00b1 ST depression + T wave inversion</td><td>\u00b1 ST depression + T wave inversion</td><td>ST elevation or otherwise meeting criteria</td></tr>\n<tr><td><strong>Troponin</strong></td><td>Negative</td><td>Negative</td><td>Positive</td><td>Positive</td></tr></tbody></table>"}]}