{"version": 1, "timestamp": 1787358813.3210104, "pages": [{"object": "page", "id": "3b55964e-68a4-8011-a12b-fbd442b2bd7a", "created_time": "2026-08-07T04:16:00.000Z", "last_edited_time": "2026-08-07T04:17:00.000Z", "created_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "last_edited_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "cover": null, "icon": null, "parent": {"type": "data_source_id", "data_source_id": "31b5964e-68a4-81bc-a928-000ba6b60df5", "database_id": "31b5964e-68a4-8023-b1c1-c7b23fbdec64"}, "in_trash": false, "is_archived": false, "is_locked": false, "properties": {"Subject": {"id": "FzC%3F", "type": "relation", "relation": [{"id": "1335964e-68a4-808d-8bbe-c7cf7a99c07b"}], "has_more": false}, "Content": {"id": "bN%7DV", "type": "rich_text", "rich_text": [{"type": "text", "text": {"content": "<ul>\n<li>Fascicular Blocks (from\u00a0<a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "<ul>\n<li>Fascicular Blocks (from\u00a0<a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/ecg-conduction-block-ecg-library/", "link": {"url": "https://litfl.com/ecg-conduction-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/ecg-conduction-block-ecg-library/", "href": "https://litfl.com/ecg-conduction-block-ecg-library/"}, {"type": "text", "text": {"content": "\">LIFTL</a>):<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">LIFTL</a>):<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "link": {"url": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "href": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left anterior fascicular block (LAFB)</a>\n<ul>\n<li>Left axis deviation</li>\n<li>qR complexes in leads I, aVL</li>\n<li>rS complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVL > 45 ms</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left anterior fascicular block (LAFB)</a>\n<ul>\n<li>Left axis deviation</li>\n<li>qR complexes in leads I, aVL</li>\n<li>rS complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVL > 45 ms</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "link": {"url": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "href": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left posterior fascicular block (LPFB)</a>\n<ul>\n<li>Right axis deviation</li>\n<li>rS complexes in leads I, aVL</li>\n<li>qR complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVF</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left posterior fascicular block (LPFB)</a>\n<ul>\n<li>Right axis deviation</li>\n<li>rS complexes in leads I, aVL</li>\n<li>qR complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVF</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "link": {"url": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "href": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Right bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant R wave in V1</li>\n<li>RSR\u2032 pattern (\"M\") in V1 with wide, slurred S wave (\"W\") in V6 (= MaRRoW)</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Right bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant R wave in V1</li>\n<li>RSR\u2032 pattern (\"M\") in V1 with wide, slurred S wave (\"W\") in V6 (= MaRRoW)</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/", "link": {"url": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/", "href": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant S wave in V1</li>\n<li>Deep S wave (\"W\") in V1 with broad R wave (\"M\") in V6 (= WiLLiaM)</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant S wave in V1</li>\n<li>Deep S wave (\"W\") in V1 with broad R wave (\"M\") in V6 (= WiLLiaM)</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/bifascicular-block-ecg-library/", "link": {"url": "https://litfl.com/bifascicular-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/bifascicular-block-ecg-library/", "href": "https://litfl.com/bifascicular-block-ecg-library/"}, {"type": "text", "text": {"content": "\">Bifascicular block</a>\n<ul>\n<li>RBBB plus either\n<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Bifascicular block</a>\n<ul>\n<li>RBBB plus either\n<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "link": {"url": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "href": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Right bundle branch block</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Right bundle branch block</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "link": {"url": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "href": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left anterior fascicular block</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left anterior fascicular block</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "link": {"url": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "href": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left posterior fascicular block</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left posterior fascicular block</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/trifascicular-block-ecg-library/", "link": {"url": "https://litfl.com/trifascicular-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/trifascicular-block-ecg-library/", "href": "https://litfl.com/trifascicular-block-ecg-library/"}, {"type": "text", "text": {"content": "\">Trifascicular block</a>\n<ul>\n<li>Bifascicular block plus 3rd degree AV block</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Trifascicular block</a>\n<ul>\n<li>Bifascicular block plus 3rd degree AV block</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/interventricular-conduction-delay-qrs-widening/", "link": {"url": "https://litfl.com/interventricular-conduction-delay-qrs-widening/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/interventricular-conduction-delay-qrs-widening/", "href": "https://litfl.com/interventricular-conduction-delay-qrs-widening/"}, {"type": "text", "text": {"content": "\">Interventricular conduction disturbance</a>\n<ul>\n<li>QRS > 100 ms, not due to LBBB or RBBB. Most important causes are:\n<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Interventricular conduction disturbance</a>\n<ul>\n<li>QRS > 100 ms, not due to LBBB or RBBB. Most important causes are:\n<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/hyperkalaemia-ecg-library/", "link": {"url": "https://litfl.com/hyperkalaemia-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/hyperkalaemia-ecg-library/", "href": "https://litfl.com/hyperkalaemia-ecg-library/"}, {"type": "text", "text": {"content": "\">Hyperkalaemia</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Hyperkalaemia</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/", "link": {"url": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/", "href": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/"}, {"type": "text", "text": {"content": "\">Tricyclic antidepressant poisoning</a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Tricyclic antidepressant poisoning</a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>", "href": null}]}, "ID": {"id": "o%3AgH", "type": "unique_id", "unique_id": {"prefix": null, "number": 5}}, "Subtag": {"id": "~Esu", "type": "select", "select": null}, "Name": {"id": "title", "type": "title", "title": [{"type": "text", "text": {"content": "Links: types of fascicular blocks with LIFTL links", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "Links: types of fascicular blocks with LIFTL links", "href": null}]}}, "url": "https://app.notion.com/p/Links-types-of-fascicular-blocks-with-LIFTL-links-3b55964e68a48011a12bfbd442b2bd7a", "public_url": "https://malleuscm.notion.site/Links-types-of-fascicular-blocks-with-LIFTL-links-3b55964e68a48011a12bfbd442b2bd7a", "archived": false}, {"object": "page", "id": "31b5964e-68a4-