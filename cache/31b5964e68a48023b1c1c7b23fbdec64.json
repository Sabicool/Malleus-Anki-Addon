{"version": 1, "timestamp": 1793851269.4973238, "pages": [{"object": "page", "id": "40c5964e-68a4-80ea-9902-c0e4643b02cd", "created_time": "2026-11-02T22:49:00.000Z", "last_edited_time": "2026-11-02T22:50:00.000Z", "created_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "last_edited_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "cover": null, "icon": null, "parent": {"type": "data_source_id", "data_source_id": "31b5964e-68a4-81bc-a928-000ba6b60df5", "database_id": "31b5964e-68a4-8023-b1c1-c7b23fbdec64"}, "in_trash": false, "is_archived": false, "is_locked": false, "properties": {"Subject": {"id": "FzC%3F", "type": "relation", "relation": [{"id": "1e85964e-68a4-80f3-b68c-e41c819d3d8a"}, {"id": "64212eae-4b7f-4e78-9d4b-cfb4905daaf9"}], "has_more": false}, "Content": {"id": "bN%7DV", "type": "rich_text", "rich_text": [{"type": "text", "text": {"content": "<div><b>Bishop Score:</b><br><table><tbody><tr><th>Component</th><th>0</th><th>1</th><th>2</th><th>3</th></tr><tr><td>Dilation (cm)</td><td>Closed</td><td>1\u20132</td><td>3\u20134</td><td>\u2265 5</td></tr><tr><td>Effacement (%)</td><td>0\u201330</td><td>40\u201350</td><td>60\u201370</td><td>\u2265 80</td></tr><tr><td>Station</td><td>\u22123</td><td>\u22122</td><td>\u22121 or 0</td><td>+1 or +2</td></tr><tr><td>Consistency</td><td>Firm</td><td>Medium</td><td>Soft</td><td>n/a</td></tr><tr><td>Position</td><td>Posterior</td><td>Mid</td><td>Anterior</td><td>n/a</td></tr></tbody></table></div><ul><li><div>The Bishop score ranges from 0\u201313 points</div></li><li><div>Multiple modified Bishop scores exist</div></li></ul><b>Australian Guidelines:</b><br><div><table border=\"1\" cellpadding=\"4\" style=\"border-collapse: collapse;\"><tbody><tr><th>Guideline</th><th>Score</th><th>Unfavourable</th><th>Favourable</th></tr><tr><td><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "<div><b>Bishop Score:</b><br><table><tbody><tr><th>Component</th><th>0</th><th>1</th><th>2</th><th>3</th></tr><tr><td>Dilation (cm)</td><td>Closed</td><td>1\u20132</td><td>3\u20134</td><td>\u2265 5</td></tr><tr><td>Effacement (%)</td><td>0\u201330</td><td>40\u201350</td><td>60\u201370</td><td>\u2265 80</td></tr><tr><td>Station</td><td>\u22123</td><td>\u22122</td><td>\u22121 or 0</td><td>+1 or +2</td></tr><tr><td>Consistency</td><td>Firm</td><td>Medium</td><td>Soft</td><td>n/a</td></tr><tr><td>Position</td><td>Posterior</td><td>Mid</td><td>Anterior</td><td>n/a</td></tr></tbody></table></div><ul><li><div>The Bishop score ranges from 0\u201313 points</div></li><li><div>Multiple modified Bishop scores exist</div></li></ul><b>Australian Guidelines:</b><br><div><table border=\"1\" cellpadding=\"4\" style=\"border-collapse: collapse;\"><tbody><tr><th>Guideline</th><th>Score</th><th>Unfavourable</th><th>Favourable</th></tr><tr><td><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.health.qld.gov.au/__data/assets/pdf_file/0020/641423/g-iol.pdf", "link": {"url": "https://www.health.qld.gov.au/__data/assets/pdf_file/0020/641423/g-iol.pdf"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.health.qld.gov.au/__data/assets/pdf_file/0020/641423/g-iol.pdf", "href": "https://www.health.qld.gov.au/__data/assets/pdf_file/0020/641423/g-iol.pdf"}, {"type": "text", "text": {"content": "\">Queensland Clinical Guidelines (2022)</a></td><td>MBS</td><td>\u2264 6 (cervical ripening recommended)</td><td>\u2265 7</td></tr><tr><td><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Queensland Clinical Guidelines (2022)</a></td><td>MBS</td><td>\u2264 6 (cervical ripening recommended)</td><td>\u2265 7</td></tr><tr><td><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.sahealth.sa.gov.au/wps/wcm/connect/ac7d37804ee4a27985598dd150ce4f37/Induction+and+Augmentation+of+Labour_PPG_V9_0.pdf", "link": {"url": "https://www.sahealth.sa.gov.au/wps/wcm/connect/ac7d37804ee4a27985598dd150ce4f37/Induction+and+Augmentation+of+Labour_PPG_V9_0.pdf"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.sahealth.sa.gov.au/wps/wcm/connect/ac7d37804ee4a27985598dd150ce4f37/Induction+and+Augmentation+of+Labour_PPG_V9_0.pdf", "href": "https://www.sahealth.sa.gov.au/wps/wcm/connect/ac7d37804ee4a27985598dd150ce4f37/Induction+and+Augmentation+of+Labour_PPG_V9_0.pdf"}, {"type": "text", "text": {"content": "\">SA Health Perinatal Practice Guideline (2021)</a></td><td>MBS</td><td>< 6</td><td>\u2265 6</td></tr><tr><td><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">SA Health Perinatal Practice Guideline (2021)</a></td><td>MBS</td><td>< 6</td><td>\u2265 6</td></tr><tr><td><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.safercare.vic.gov.au/best-practice-improvement/clinical-guidance/maternity/induction-of-labour", "link": {"url": "https://www.safercare.vic.gov.au/best-practice-improvement/clinical-guidance/maternity/induction-of-labour"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.safercare.vic.gov.au/best-practice-improvement/clinical-guidance/maternity/induction-of-labour", "href": "https://www.safercare.vic.gov.au/best-practice-improvement/clinical-guidance/maternity/induction-of-labour"}, {"type": "text", "text": {"content": "\">Safer Care Victoria eHandbook</a></td><td>'Bishop score' (version not stated)</td><td>< 6 (PGE<sub>2</sub> only if \u2264 5)</td><td>n/a</td></tr><tr><td><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Safer Care Victoria eHandbook</a></td><td>'Bishop score' (version not stated)</td><td>< 6 (PGE<sub>2</sub> only if \u2264 5)</td><td>n/a</td></tr><tr><td><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://ranzcog.edu.au/wp-content/uploads/Prostaglandins-lnduction-of-Labour.pdf", "link": {"url": "https://ranzcog.edu.au/wp-content/uploads/Prostaglandins-lnduction-of-Labour.pdf"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://ranzcog.edu.au/wp-content/uploads/Prostaglandins-lnduction-of-Labour.pdf", "href": "https://ranzcog.edu.au/wp-content/uploads/Prostaglandins-lnduction-of-Labour.pdf"}, {"type": "text", "text": {"content": "\">RANZCOG C-Obs 22</a></td><td>'Cervical or Bishop score'</td><td>No cut-off in the text reviewed</td><td>n/a</td></tr></tbody></table></div><b>Other sources:</b><br><ul><li><div><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">RANZCOG C-Obs 22</a></td><td>'Cervical or Bishop score'</td><td>No cut-off in the text reviewed</td><td>n/a</td></tr></tbody></table></div><b>Other sources:</b><br><ul><li><div><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.mdcalc.com/calc/3320/bishop-score-vaginal-delivery-induction-labor#evidence", "link": {"url": "https://www.mdcalc.com/calc/3320/bishop-score-vaginal-delivery-induction-labor#evidence"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.mdcalc.com/calc/3320/bishop-score-vaginal-delivery-induction-labor#evidence", "href": "https://www.mdcalc.com/calc/3320/bishop-score-vaginal-delivery-induction-labor#evidence"}, {"type": "text", "text": {"content": "\">MDCalc</a>:</div></li><ul><li>'Scores \u2264 5 suggest an unfavorable cervix, and that induction may be necessary for successful vaginal delivery.</li><li>Scores 6\u20137 do not definitively predict whether or not induction will be successful. Consider induction or augmentation of labor based on clinical judgment.</li><li>Scores \u2265 8 suggest spontaneous vaginal delivery is more likely and augmentation or induction may be unnecessary.'</li></ul><li>Williams Obstetrics:<div></div></li><ul><li>'A Bishop score of 9 conveys a high likelihood for a successful induction ... For research purposes, a Bishop score of 4 or less identifies an unfavorable cervix and may be an indication for cervical ripening.'\u00a0</li></ul><li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">MDCalc</a>:</div></li><ul><li>'Scores \u2264 5 suggest an unfavorable cervix, and that induction may be necessary for successful vaginal delivery.</li><li>Scores 6\u20137 do not definitively predict whether or not induction will be successful. Consider induction or augmentation of labor based on clinical judgment.</li><li>Scores \u2265 8 suggest spontaneous vaginal delivery is more likely and augmentation or induction may be unnecessary.'</li></ul><li>Williams Obstetrics:<div></div></li><ul><li>'A Bishop score of 9 conveys a high likelihood for a successful induction ... For research purposes, a Bishop score of 4 or less identifies an unfavorable cervix and may be an indication for cervical ripening.'\u00a0</li></ul><li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.ncbi.nlm.nih.gov/books/NBK470368/", "link": {"url": "https://www.ncbi.nlm.nih.gov/books/NBK470368/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.ncbi.nlm.nih.gov/books/NBK470368/", "href": "https://www.ncbi.nlm.nih.gov/books/NBK470368/"}, {"type": "text", "text": {"content": "\">StatPearls</a>:</li><ul><li>'A score of > 8 typically indicates a favorable condition for elective induction, particularly in multiparous women at term with uncomplicated pregnancies.'</li></ul></ul><b>Sources:\u00a0</b><br><ul><ul><li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">StatPearls</a>:</li><ul><li>'A score of > 8 typically indicates a favorable condition for elective induction, particularly in multiparous women at term with uncomplicated pregnancies.'</li></ul></ul><b>Sources:\u00a0</b><br><ul><ul><li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://pubmed.ncbi.nlm.nih.gov/14199536", "link": {"url": "https://pubmed.ncbi.nlm.nih.gov/14199536"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://pubmed.ncbi.nlm.nih.gov/14199536", "href": "https://pubmed.ncbi.nlm.nih.gov/14199536"}, {"type": "text", "text": {"content": "\">Bishop EH. Pelvic scoring for elective induction. Obstet Gynecol. 1964;24(2):266\u20138. PMID 14199536.</a></li><li>Lange AP, Secher NJ, Westergaard JG, Skovg\u00e5rd I. Prelabor evaluation of inducibility. Obstet Gynecol. 1982;60(2):137\u201347.</li><li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Bishop EH. Pelvic scoring for elective induction. Obstet Gynecol. 1964;24(2):266\u20138. PMID 14199536.</a></li><li>Lange AP, Secher NJ, Westergaard JG, Skovg\u00e5rd I. Prelabor evaluation of inducibility. Obstet Gynecol. 1982;60(2):137\u201347.</li><li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.ncbi.nlm.nih.gov/pubmed/18757646", "link": {"url": "https://www.ncbi.nlm.nih.gov/pubmed/18757646"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.ncbi.nlm.nih.gov/pubmed/18757646", "href": "https://www.ncbi.nlm.nih.gov/pubmed/18757646"}, {"type": "text", "text": {"content": "\">Newman RB, Goldenberg RL, Iams JD, et al. Preterm Prediction Study: comparison of the cervical score and Bishop score for prediction of spontaneous preterm delivery. Obstet Gynecol. 2008;112(3):508\u201315. doi:10.1097/AOG.0b013e3181842087. PMID 18757646.</a></li><li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Newman RB, Goldenberg RL, Iams JD, et al. Preterm Prediction Study: comparison of the cervical score and Bishop score for prediction of spontaneous preterm delivery. Obstet Gynecol. 2008;112(3):508\u201315. doi:10.1097/AOG.0b013e3181842087. PMID 18757646.</a></li><li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3297470/", "link": {"url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3297470/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3297470/", "href": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3297470/"}, {"type": "text", "text": {"content": "\">Laughon SK, Zhang J, Troendle J, Sun L, Reddy UM. Using a simplified Bishop score to predict vaginal delivery. Obstet Gynecol. 2011;117(4):805\u201311. doi:10.1097/AOG.0b013e3182114ad2. PMID 21383643.</a></li><li>Cunningham FG, Leveno KJ, Bloom SL, Spong CY, Dashe JS, Hoffman BL, et al., editors. Chapter 26, Induction and augmentation of labor. In: <span style=\"font-style: italic;\">Williams Obstetrics</span>. 24th ed. New York: McGraw-Hill Education; 2014. p. 525.</li></ul></ul>", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Laughon SK, Zhang J, Troendle J, Sun L, Reddy UM. Using a simplified Bishop score to predict vaginal delivery. Obstet Gynecol. 2011;117(4):805\u201311. doi:10.1097/AOG.0b013e3182114ad2. PMID 21383643.</a></li><li>Cunningham FG, Leveno KJ, Bloom SL, Spong CY, Dashe JS, Hoffman BL, et al., editors. Chapter 26, Induction and augmentation of labor. In: <span style=\"font-style: italic;\">Williams Obstetrics</span>. 24th ed. New York: McGraw-Hill Education; 2014. p. 525.</li></ul></ul>", "href": null}]}, "ID": {"id": "o%3AgH", "type": "unique_id", "unique_id": {"prefix": null, "number": 8}}, "Subtag": {"id": "~Esu", "type": "select", "select": {"id": "044ec6f8-6021-4a88-8b69-95a74a55f722", "name": "Diagnosis/Investigations", "color": "pink"}}, "Name": {"id": "title", "type": "title", "title": [{"type": "text", "text": {"content": "Bishop score ", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "Bishop score ", "href": null}]}}, "url": "https://app.notion.com/p/Bishop-score-40c5964e68a480ea9902c0e4643b02cd", "public_url": "https://malleuscm.notion.site/Bishop-score-40c5964e68a480ea9902c0e4643b02cd", "archived": false}, {"object": "page", "id": "3fc5964e-68a4-8023-9207-d57d7f05195b", "created_time": "2026-10-17T21:41:00.000Z", "last_edited_time": "2026-10-17T21:42:00.000Z", "created_by": {"object": "user", "id": "285d872b-594c-8164-92ed-0002e86c7446"}, "last_edited_by": {"object": "user", "id": "285d872b-594c-8164-92ed-0002e86c7446"}, "cover": null, "icon": null, "parent": {"type": "data_source_id", "data_source_id": "31b5964e-68a4-81bc-a928-000ba6b60df5", "database_id": "31b5964e-68a4-8023-b1c1-c7b23fbdec64"}, "in_trash": false, "is_archived": false, "is_locked": false, "properties": {"Subject": {"id": "FzC%3F", "type": "relation", "relation": [{"id": "1af5964e-68a4-80d2-9905-c26ad79dcc86"}, {"id": "1d55964e-68a4-808f-a59c-ca8f1cb47b78"}], "has_more": false}, "Content": {"id": "bN%7DV", "type": "rich_text", "rich_text": [{"type": "text", "text": {"content": "<img src=\"ab29d6dcfb3ceef3e987ffd0c0468af6.webp\"><br><img src=\"7aa44bc26acbd1b076eef43bfd0420e2.webp\">", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "<img src=\"ab29d6dcfb3ceef3e987ffd0c0468af6.webp\"><br><img src=\"7aa44bc26acbd1b076eef43bfd0420e2.webp\">", "href": null}]}, "ID": {"id": "o%3AgH", "type": "unique_id", "unique_id": {"prefix": null, "number": 7}}, "Subtag": {"id": "~Esu", "type": "select", "select": {"id": "044ec6f8-6021-4a88-8b69-95a74a55f722", "name": "Diagnosis/Investigations", "color": "pink"}}, "Name": {"id": "title", "type": "title", "title": [{"type": "text", "text": {"content": "Image: seizure classification flowchart (2025)", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "Image: seizure classification flowchart (2025)", "href": null}]}}, "url": "https://app.notion.com/p/Image-seizure-classification-flowchart-2025-3fc5964e68a480239207d57d7f05195b", "public_url": "https://malleuscm.notion.site/Image-seizure-classification-flowchart-2025-3fc5964e68a480239207d57d7f05195b", "archived": false}, {"object": "page", "id": "3b55964e-68a4-8011-a12b-fbd442b2bd7a", "created_time": "2026-08-07T04:16:00.000Z", "last_edited_time": "2026-08-07T04:17:00.000Z", "created_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "last_edited_by": {"object": "user", "id": "285d872b-594c-8105-a372-0002d4ecdcbe"}, "cover": null, "icon": null, "parent": {"type": "data_source_id", "data_source_id": "31b5964e-68a4-81bc-a928-000ba6b60df5", "database_id": "31b5964e-68a4-8023-b1c1-c7b23fbdec64"}, "in_trash": false, "is_archived": false, "is_locked": false, "properties": {"Subject": {"id": "FzC%3F", "type": "relation", "relation": [{"id": "1335964e-68a4-808d-8bbe-c7cf7a99c07b"}], "has_more": false}, "Content": {"id": "bN%7DV", "type": "rich_text", "rich_text": [{"type": "text", "text": {"content": "<ul>\n<li>Fascicular Blocks (from\u00a0<a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "<ul>\n<li>Fascicular Blocks (from\u00a0<a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/ecg-conduction-block-ecg-library/", "link": {"url": "https://litfl.com/ecg-conduction-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/ecg-conduction-block-ecg-library/", "href": "https://litfl.com/ecg-conduction-block-ecg-library/"}, {"type": "text", "text": {"content": "\">LIFTL</a>):<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">LIFTL</a>):<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "link": {"url": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "href": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left anterior fascicular block (LAFB)</a>\n<ul>\n<li>Left axis deviation</li>\n<li>qR complexes in leads I, aVL</li>\n<li>rS complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVL > 45 ms</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left anterior fascicular block (LAFB)</a>\n<ul>\n<li>Left axis deviation</li>\n<li>qR complexes in leads I, aVL</li>\n<li>rS complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVL > 45 ms</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "link": {"url": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "href": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left posterior fascicular block (LPFB)</a>\n<ul>\n<li>Right axis deviation</li>\n<li>rS complexes in leads I, aVL</li>\n<li>qR complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVF</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left posterior fascicular block (LPFB)</a>\n<ul>\n<li>Right axis deviation</li>\n<li>rS complexes in leads I, aVL</li>\n<li>qR complexes in leads II, III, aVF</li>\n<li>Prolonged R wave peak time in aVF</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "link": {"url": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "href": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Right bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant R wave in V1</li>\n<li>RSR\u2032 pattern (\"M\") in V1 with wide, slurred S wave (\"W\") in V6 (= MaRRoW)</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Right bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant R wave in V1</li>\n<li>RSR\u2032 pattern (\"M\") in V1 with wide, slurred S wave (\"W\") in V6 (= MaRRoW)</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/", "link": {"url": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/", "href": "https://litfl.com/left-bundle-branch-block-lbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant S wave in V1</li>\n<li>Deep S wave (\"W\") in V1 with broad R wave (\"M\") in V6 (= WiLLiaM)</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left bundle branch block</a>\n<ul>\n<li>QRS > 120 ms</li>\n<li>Dominant S wave in V1</li>\n<li>Deep S wave (\"W\") in V1 with broad R wave (\"M\") in V6 (= WiLLiaM)</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/bifascicular-block-ecg-library/", "link": {"url": "https://litfl.com/bifascicular-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/bifascicular-block-ecg-library/", "href": "https://litfl.com/bifascicular-block-ecg-library/"}, {"type": "text", "text": {"content": "\">Bifascicular block</a>\n<ul>\n<li>RBBB plus either\n<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Bifascicular block</a>\n<ul>\n<li>RBBB plus either\n<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "link": {"url": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/", "href": "https://litfl.com/right-bundle-branch-block-rbbb-ecg-library/"}, {"type": "text", "text": {"content": "\">Right bundle branch block</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Right bundle branch block</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "link": {"url": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/", "href": "https://litfl.com/left-anterior-fascicular-block-lafb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left anterior fascicular block</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left anterior fascicular block</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "link": {"url": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/", "href": "https://litfl.com/left-posterior-fascicular-block-lpfb-ecg-library/"}, {"type": "text", "text": {"content": "\">Left posterior fascicular block</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Left posterior fascicular block</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/trifascicular-block-ecg-library/", "link": {"url": "https://litfl.com/trifascicular-block-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/trifascicular-block-ecg-library/", "href": "https://litfl.com/trifascicular-block-ecg-library/"}, {"type": "text", "text": {"content": "\">Trifascicular block</a>\n<ul>\n<li>Bifascicular block plus 3rd degree AV block</li>\n</ul>\n</li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Trifascicular block</a>\n<ul>\n<li>Bifascicular block plus 3rd degree AV block</li>\n</ul>\n</li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/interventricular-conduction-delay-qrs-widening/", "link": {"url": "https://litfl.com/interventricular-conduction-delay-qrs-widening/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/interventricular-conduction-delay-qrs-widening/", "href": "https://litfl.com/interventricular-conduction-delay-qrs-widening/"}, {"type": "text", "text": {"content": "\">Interventricular conduction disturbance</a>\n<ul>\n<li>QRS > 100 ms, not due to LBBB or RBBB. Most important causes are:\n<ul>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Interventricular conduction disturbance</a>\n<ul>\n<li>QRS > 100 ms, not due to LBBB or RBBB. Most important causes are:\n<ul>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/hyperkalaemia-ecg-library/", "link": {"url": "https://litfl.com/hyperkalaemia-ecg-library/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/hyperkalaemia-ecg-library/", "href": "https://litfl.com/hyperkalaemia-ecg-library/"}, {"type": "text", "text": {"content": "\">Hyperkalaemia</a></li>\n<li><a href=\"", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Hyperkalaemia</a></li>\n<li><a href=\"", "href": null}, {"type": "text", "text": {"content": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/", "link": {"url": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/"}}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/", "href": "https://litfl.com/tricyclic-overdose-sodium-channel-blocker-toxicity/"}, {"type": "text", "text": {"content": "\">Tricyclic antidepressant poisoning</a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "\">Tricyclic antidepressant poisoning</a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>", "href": null}]}, "ID": {"id": "o%3AgH", "type": "unique_id", "unique_id": {"prefix": null, "number": 5}}, "Subtag": {"id": "~Esu", "type": "select", "select": null}, "Name": {"id": "title", "type": "title", "title": [{"type": "text", "text": {"content": "Links: types of fascicular blocks with LIFTL links", "link": null}, "annotations": {"bold": false, "italic": false, "strikethrough": false, "underline": false, "code": false, "color": "default"}, "plain_text": "Links: types of fascicular blocks with LIFTL links", "href": null}]}}, "url": "https://app.notion.com/p/Links-types-of-fascicular-blocks-with-LIFTL-links-3b55964e68a48011a12bfbd442b2bd7a", "public_url": "https://malleuscm.notion.site/Links-types-of-fascicular-blocks-with-LIFTL-links-3b55964e68a48011a12bfbd442b2bd7a", "archived": false}, {"object": "page", "id": "31b5964e-68a4-8174-976b-ca8cb2e4b9fe", "created_time": "2026-03-06T09:21:00.000Z", "last_edited_time": "2026-10-17T21:42:00.000Z", "created_by": {"object": "user", "id": "b34a9a35-90e8-4993-b980-07875455ab51"}, "last_edited_by": {"object": "user", "id": "285d872b-594c-8164-92ed-0002e86c7446"}, "cover": null, "icon": null, "parent": {"typ