# Ignore macOS system files
.DS_Store

# Ignore backup files (ending with ~)
*~

__pycache__/*
ui/__pycache__/*
meta.json
readme for ankiweb.md
#cache/*
# Raw graph + cross-ref seeds (cache/_raw_*.json, cache/_xref_*.json) are
# committed by the daily CI build so the add-on can re-seed its incremental
# refresh from GitHub.  Stray temp files from their atomic writes are not.
cache/*.tmp*
# GitHub conditional-download metadata (ETags / last-verified) — local only
cache/_github_meta.json
# Runtime user data (caches, raw graphs, recents) — preserved by Anki across
# add-on updates, never committed or packaged
user_files/
*.zip
.env
recent_tags.json

# Optional: Ignore node_modules, if relevant to the project
node_modules/

# Local virtualenv for testing
.venv/

# Hierarchy-tag test scratch artifacts
tests/_out/

test.py
